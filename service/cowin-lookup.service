[Unit]
Description=CoWIN Vaccination Center Lookup Microservice
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/cowin
ExecStart=/usr/bin/python3 /opt/cowin/app.py --port 8080
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/default/cowin-lookup

[Install]
WantedBy=multi-user.target
